# Solana RPC (devnet). Helius devnet endpoint works well.
RPC_URL=https://api.devnet.solana.com
NETWORK=devnet
# Bridge authority keypair (mint authority for GP + all item tokens, pool payer, vault owner in v1)
BRIDGE_KEYPAIR_PATH=./.keys/bridge.json
# Engine web origin used to build token metadata URIs
ENGINE_WEB_URL=http://localhost:8888
# --- M2+ (daemon) ---
DB_PATH=../server/engine/db.sqlite
BRIDGE_DAEMON_PORT=7781
